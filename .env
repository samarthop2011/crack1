# ─────────────────────────────────────────────
#  MegaRAC Hunter — 24/7 keyless config
#  no API keys anywhere. only your discord token.
# ─────────────────────────────────────────────

# discord
DISCORD_TOKEN=MTIz_your_bot_token_here
CHANNEL_ID=0            # 0 = first channel it can post in
PREFIX=!

# the hunt
DORK=ssl.cert.issuer.cn="megarac.com" && app="lighttpd" && country!="CN" && port="443"

# ── scan like hell ──────────────────────────
DISCOVERY_WORKERS=60     # threads hitting the 40 sources
VERIFY_CONCURRENCY=1000  # parallel TLS/fingerprint checks
CVE_CONCURRENCY=300      # parallel CVE-2024-54085 probes
TLS_TIMEOUT=5            # per-host handshake cap (secs)
HTTP_TIMEOUT=7           # per-host http cap (secs)

# ── loop behaviour ──────────────────────────
CYCLE_SLEEP=20           # secs between full cycles
RECHECK_EVERY=6          # re-verify known vulns every N cycles (0 = off)
EXPAND=1                 # /24 sweep around every confirmed host
ANNOUNCE_CONFIRMED=1     # post live MegaRACs too, not just vulns

# ── alerts ──────────────────────────────────
PING=@here               # ping on new vulnerable host ("" = silent)
